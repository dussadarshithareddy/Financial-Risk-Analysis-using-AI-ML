# Copy this file to .env locally and provide secrets through your secret manager.
MONGODB_URI=
MONGODB_DATABASE=fraud_detection_db
MODEL_STORAGE_BACKEND=local
MODEL_ARTIFACT_SIGNING_KEY=

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
DEBUG=True
ENVIRONMENT=development

# JWT; replace locally before use outside development.
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Optional dashboard and local development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
API_BASE_URL=http://127.0.0.1:8000

# Model training and data
ML_MODEL_THRESHOLD=0.5
ENABLE_ML_DETECTION=True
DATASET_PATH=data/raw/creditcard.csv
SYNTHETIC_DATA_SIZE=10000

# Security and logging
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
